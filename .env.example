# Google Cloud Configuration
GCP_PROJECT_ID=fde-kb-agent-dev
GCP_LOCATION=us-central1
DEFAULT_MODEL_NAME=gemini-2.5-flash
LIGHTWEIGHT_MODEL_NAME=gemini-2.5-flash-lite
PRO_MODEL_NAME=gemini-2.5-pro
DATA_STORE_ID=kb-datastore-dev
DEFAULT_K8S_DOCS_URL=https://cloud.google.com/docs
DEFAULT_DOC_TITLE=Knowledge Base Documentation
CORS_ALLOWED_ORIGINS=*

# Telemetry & Observability
TELEMETRY_DATASET=telemetry
TELEMETRY_TABLE=request_logs
ENABLE_CLOUD_TRACE=true

# Security & Model Armor
ENABLE_DLP_REDACTION=true
DLP_TEMPLATE_ID=
